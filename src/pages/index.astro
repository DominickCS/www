---
import '../styles/global.css';
import NavigationBar from '../components/NavigationBar.astro';
import Footer from '../components/Footer.astro';
import { Font } from 'astro:assets';
import { Image } from 'astro:assets';
import pfp from '../images/pfp.jpg';
import controller from '../images/controller-icon.svg';
import music_note from '../images/music-icon.svg';
import textbook_icon from '../images/textbook-icon.svg';
import code_icon from '../images/code-icon.svg';
---
<style>
.pfp-widget-container {
  gap: 8px;
  display: grid;
}

.widget-container {
  display: grid;
  gap: 8px;
  align-items: stretch;
  text-align: center;
}

@media screen and (min-width: 320px) and (max-width: 1024px){
  .widget-container {
  grid-template-columns: 1fr;
  }

  .pfp-widget-container {
  grid-template-columns: 1fr;
  }

}

@media screen and (min-width: 1024px){
  .widget-container {
  grid-template-columns: 1fr 1fr;
  }
  
  .pfp-widget-container{
  grid-template-columns: .5fr 1fr;
  }

}

.intro-paragraph-container {
  font-size: 20px;
  margin: 0 auto;
  text-align: left;
}

section {
  font-family: var(--font-inconsolata);
  max-width: 80vw;
  margin: 0 auto;
  min-height: 100svh;
}

.now-gaming-container {
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: center;
  border: dotted #737994 3px;
  border-radius: 9px;
  padding: 18px;
}

.now-music-container {
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: center;
  border: dotted #737994 3px;
  border-radius: 9px;
  padding: 18px;
}

.now-study-container {
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: center;
  border: dotted #737994 3px;
  border-radius: 9px;
  padding: 18px;
}

.now-building-container {
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: center;
  border: dotted #737994 3px;
  border-radius: 9px;
  padding: 18px;
}


.pfp {
  border-radius: 9px;
  border: dotted #737994 3px;
  box-shadow: 0px 6px 12px #73799431;
  display: block;
  max-width: 100%;
  max-height: 65vh;
  width: auto;
  height: auto;
  border-radius: 9px;
  margin: 0 auto;
  object-fit: contain;
}

.pfp img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 9px;
}

</style>

<html lang="en">
	<head>
		<Font cssVariable='--font-inconsolata' />
		<meta charset="utf-8" />
		<link rel="icon" type="image/ico" href="/favicon.ico" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
    <title>home - developing with DominickCS_</title>
    <meta name="description" content="The home page of developing with DominickCS_" />
	</head>
	<body>
    <NavigationBar />
    <main>
      <section>
      <div class="pfp-widget-container">
        <div class="pfp">
          <Image src={pfp} alt="Dominick smiling, wearing a dark hoodie." quality="low" loading={'eager'} />
        </div>
        <div class="widget-container">
          <div class="now-gaming-container">
            <Image src={controller} height={30} alt={'A controller icon'} loading={'eager'}/>
            <div>
            <h3>currently playing</h3>
            <p>Modded Minecraft - Project Ozone 3</p>
            </div>
          </div>
          <div class="now-music-container">
            <Image src={music_note} height={30} alt={'A music note icon'} loading={'eager'}/>
            <div>
            <h3>on repeat</h3>
            <p>Anything on Monstercat lol</p>
            </div>
          </div>
          <div class="now-study-container">
            <Image src={textbook_icon} height={30} alt={'A textbook icon'} loading={'eager'} />
            <div>
            <h3>studying</h3>
            <p>Rust</p>
            </div>
          </div>
          <div class="now-building-container">
            <Image src={code_icon} height={30} alt={'A code icon'} loading={'eager'} />
            <div>
            <h3>building</h3>
            <p>a client art store in Spring Boot + React.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="intro-paragraph-container">
          <p>
            Hey, welcome to my website. My name is Dominick, a.k.a DominickCS. Born and raised in Texas, but don't let the lack of a cowboy hat fool you. I'm still a cowboy, just wrangling code instead of cattle lol. Here on my website you can expect to find things that I am passionate about.
          </p>
          <p>I am on here updating this site regularly so if you'd like to follow along, please feel free. Who knows maybe we can be friends!</p>
        </div>
      </section>
    </main>
      <Footer />
	</body>
  </html>
