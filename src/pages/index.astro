---
import '../styles/global.css';
import NavigationBar from '../components/NavigationBar.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { Font } from 'astro:assets';
import { Image } from 'astro:assets';
import pfp from '../images/pfp.jpg';
import controller from '../images/controller-icon.svg';
import music_note from '../images/music-icon.svg';
import textbook_icon from '../images/textbook-icon.svg';
import code_icon from '../images/code-icon.svg';
---
<style>

.pfp-widget-container {
  gap: 8px;
  display: grid;
  line-height: 0.3rem;
  margin: 21px auto;
}

.widget-container {
  display: grid;
  gap: 8px;
}

@media screen and (min-width: 320px) and (max-width: 1024px){
  .widget-container {
  grid-template-columns: auto;
  }

  .pfp-widget-container{
  grid-template-columns: auto;
  }

  h3, p {
  text-align: left;
  }
}

@media screen and (min-width: 1024px){
  .widget-container {
  grid-template-columns: auto auto;
  }
  
  .pfp-widget-container{
  grid-template-columns: auto auto;
  }

  h3, p {
  text-align: left;
  }
}

.intro-paragraph-container {
  padding: 3px;
  margin: 0 auto;
}

main {
  font-family: var(--font-inconsolata);
  max-width: 90vw;
  margin: 0 auto;
  min-height: 100svh;
}

.now-gaming-container {
  display: flex;
  align-items: stretch;
  border: dotted #737994 3px;
  border-radius: 9px;
  padding: 9px;
}

.now-music-container {
  display: flex;
  align-items: stretch;
  border: dotted #737994 3px;
  border-radius: 9px;
  padding: 9px;
}

.now-study-container {
  display: flex;
  align-items: stretch;
  border: dotted #737994 3px;
  border-radius: 9px;
  padding: 9px;
}

.now-building-container {
  display: flex;
  align-items: stretch;
  border: dotted #737994 3px;
  border-radius: 9px;
  padding: 9px;
}

.pfp {
  border-radius: 9px;
  border: dotted #737994 3px;
  box-shadow: 0px 6px 12px #73799431;
  display: block;
  margin: 0 auto;
}

.controller {
  border-radius: 9px;
  border: dotted #737994 3px;
  box-shadow: 0px 6px 12px #73799430;
  padding: 6px;
  margin-right: 9px;
}

.music_note {
  border-radius: 9px;
  border: dotted #737994 3px;
  box-shadow: 0px 6px 12px #73799430;
  padding: 6px;
  margin-right: 9px;
}

.textbook_icon {
  border-radius: 9px;
  border: dotted #737994 3px;
  box-shadow: 0px 6px 12px #73799430;
  padding: 6px;
  margin-right: 9px;
}

.code_icon {
  border-radius: 9px;
  border: dotted #737994 3px;
  box-shadow: 0px 6px 12px #73799430;
  padding: 6px;
  margin-right: 9px;
}

</style>

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-inconsolata" />
    <BaseHead title='developing with DominickCS_' description='The index page of developing with DominickCS_' />
	</head>
	<body>
    <NavigationBar />
    <main>
      <section>
      <div class="pfp-widget-container">
        <div>
          <Image src={pfp} class={'pfp'} alt="Dominick smiling, wearing a dark hoodie." height={500} quality="high" loading={'eager'} />
        </div>
        <div class="widget-container">
          <div class="now-gaming-container">
            <Image class={'controller'} src={controller} height={30} alt={'A controller icon'} loading={'eager'}/>
            <div>
            <h3>currently playing</h3>
            <p>Modded Minecraft - SevTech Ages</p>
            </div>
          </div>
          <div class="now-music-container">
            <Image class={'music_note'} src={music_note} height={30} alt={'A music note icon'} loading={'eager'}/>
            <div>
            <h3>on repeat</h3>
            <p>Kaytranada - 99.9%</p>
            </div>
          </div>
          <div class="now-study-container">
            <Image class={'textbook_icon'} src={textbook_icon} height={30} alt={'A textbook icon'} loading={'eager'} />
            <div>
            <h3>studying</h3>
            <p>K&R's "The C Programming Language"</p>
            </div>
          </div>
          <div class="now-building-container">
            <Image class={'code_icon'} src={code_icon} height={30} alt={'A code icon'} loading={'eager'} />
            <div>
            <h3>building</h3>
            <p>a client art store in Spring Boot + React.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="intro-paragraph-container">
          <p>
            Hey, welcome to my website. My name is Dominick, a.k.a DominickCS. Born and raised in Texas, but don't let the lack of a cowboy hat fool you.. I'm still a cowboy, just wrangling code instead of cattle lol. Here on my website you can expect to find things that I am passionate about.
          </p>
          <p>I am on here updating this site regularly so if you'd like to follow along, please feel free. Who knows maybe we can be friends!</p>
        </div>
      </section>
    </main>
	</body>
  <footer>
    <Footer />
  </footer>
</html>
