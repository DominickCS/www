---
import { Font } from 'astro:assets';
import { Image } from 'astro:assets';
import NavigationBar from '../../components/NavigationBar.astro';
import BaseHead from '../../components/BaseHead.astro';
import DateFormatter from '../../components/DateFormatter.astro';
import { getCollection } from "astro:content";

const posts = (await getCollection('blog')).sort((a , b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<style>
main {
  padding-top: 9px;
  font-family: var(--font-inconsolata);
}

.post-container:hover {
  scale: .97;
  background-color: #949cbb20;
  transition: all;
  transition-duration: 300ms;
}

.post-container {
  transition: all;
  transition-duration: 300ms;
  max-width: 400px;
  max-height: 240px;
  margin: 18px auto;
  padding: 9px;
  border: dotted #737994 3px;
  border-radius: 9px;
}

.date, .title {
  margin: 9px 0;
}

.title {
  font-size: 18px;
  line-height: 1.6rem;
}

.date {
  font-size: 12px;
  font-style: italic;
}

section {
  margin: 0 auto;
  max-width: 85vw;
  display: flex;
  flex-wrap: wrap;
}

img {
	width: 100%;
  max-height: 120px;
  object-fit: cover;
  border-radius: 9px;
}

hr {
  width: 60%;
}

</style>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <BaseHead title='blog - developing with DominickCS_' description='The home page of my blog' />
    <Font cssVariable="--font-inconsolata" />
  </head>
  <body>
    <NavigationBar />
    <main>
			<section>
					{
						posts.map((post) => (
              <div class="post-container">
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
                  <Image src={post.data.heroImage} alt={post.data.heroImageAlt} loading={'eager'} />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">

                    <DateFormatter date={post.data.publishDate} />
									</p>
								</a>
							</div>
						))
					}
			</section>
		</main>
  </body>
</html>
