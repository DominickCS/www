---
import { Font } from 'astro:assets';
import { Image } from 'astro:assets';
import NavigationBar from '../../components/NavigationBar.astro';
import BaseHead from '../../components/BaseHead.astro';
import DateFormatter from '../../components/DateFormatter.astro';
import { getCollection } from "astro:content";

const posts = (await getCollection('blog')).sort((a , b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<style>
main {
  margin: 0 auto;
  justify-items: center;
  font-family: var(--font-inconsolata);
}

.title,
.date 
{
  margin: 3px 0px;
  padding: 3px 12px;
}

.title {
  font-size: 24px;
  line-height: 2rem;
}

.date {
  font-size: 12px;
  font-style: italic;
}

section {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

div {
  margin: 12px 12px;
  border: solid #737994 3px;
  border-radius: 6px;
  max-width: 400px;
}

img {
	width: 100%;
  max-height: 200px;
  object-fit: cover;
  border-bottom: solid #737994 3px;
}

hr {
  width: 20%;
}

.description {
  width: 90%;
  justify-self: center;
}
</style>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <BaseHead title='Blog Index - Developing with DominickCS_' description='The index of my blog!' />
    <Font cssVariable="--font-inconsolata" />
  </head>
  <body>
    <NavigationBar />
    <main>
			<section>
					{
						posts.map((post) => (
              <div>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
                  <Image src={post.data.heroImage} alt={post.data.heroImageAlt} />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">

                    <DateFormatter date={post.data.publishDate} />
									</p>
                        <hr />

            <p class="description">
              {post.data.description}
            </p>
								</a>
							</div>
						))
					}
			</section>
		</main>
  </body>
</html>
